{
  "name": "alarm",
  "display_name": "闹钟",
  "description": "Manage local alarms.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "set",
          "list",
          "cancel"
        ],
        "description": "set to set, list to list, cancel to cancel."
      },
      "time": {
        "type": "string",
        "description": "Required for action=set: a duration or a clock time."
      },
      "label": {
        "type": "string",
        "description": "Optional for action=set: alarm label."
      },
      "audio_file": {
        "type": "string",
        "description": "Optional for action=set: local .wav or .mp3 file."
      },
      "id": {
        "type": "string",
        "description": "Required for action=cancel: alarm id."
      }
    },
    "required": [
      "action"
    ]
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "alarms"
  ]
}
