{
  "name": "print_image",
  "display_name": "显示图片",
  "description": "Print or render an image.",
  "parameters": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "description": "Local image path."
      },
      "size": {
        "type": "string",
        "description": "Optional chafa size, e.g. 80x40, to keep the output from getting too large."
      }
    },
    "required": [
      "image"
    ]
  },
  "permission": "readonly",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "images"
  ]
}
