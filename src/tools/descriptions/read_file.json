{
  "name": "read_file",
  "display_name": "读取文件",
  "description": "Read a UTF-8 text file with 1-based line pagination, or list a directory page by page.",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "File or directory path."
      },
      "offset": {
        "type": "integer",
        "description": "Start line, 1-based."
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of lines to read."
      }
    },
    "required": [
      "path"
    ]
  },
  "permission": "readonly",
  "always_loaded": true,
  "load_policy": "summary",
  "groups": [
    "dev-read"
  ]
}
