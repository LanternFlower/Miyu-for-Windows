{
  "name": "glob",
  "display_name": "查找文件",
  "description": "Find files under a directory by a case-insensitive glob pattern.",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Directory to search, defaults to the workspace; use ~ or /home for user files, or / for a protected global search."
      },
      "pattern": {
        "type": "string",
        "description": "Case-insensitive glob pattern, e.g. *ai*测试*."
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum number of results."
      }
    },
    "required": [
      "pattern"
    ]
  },
  "permission": "readonly",
  "always_loaded": true,
  "load_policy": "summary",
  "groups": [
    "dev-read"
  ]
}
