{
  "name": "todowrite",
  "display_name": "任务列表",
  "description": "Maintain this session's task list. Pass todos to replace the whole list, or updates for incremental changes.",
  "parameters": {
    "type": "object",
    "properties": {
      "todos": {
        "type": "array",
        "description": "The complete task list. This operation replaces the entire list.",
        "items": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "description": "Short task description."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "required": [
            "content",
            "status",
            "priority"
          ]
        }
      },
      "updates": {
        "type": "array",
        "description": "Task changes applied atomically, in order.",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "remove",
                "clear"
              ]
            },
            "index": {
              "type": "integer",
              "description": "Target task number, 1-based. For add, the insertion position; omit to append."
            },
            "match_content": {
              "type": "string",
              "description": "When index is omitted, the full content used to locate the target task."
            },
            "content": {
              "type": "string",
              "description": "The task content to add, or the content after modification."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "required": [
            "action"
          ]
        }
      }
    }
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "summary",
  "groups": [
    "planning"
  ]
}
