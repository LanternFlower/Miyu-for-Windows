{
  "name": "manage_skill",
  "display_name": "管理技能",
  "description": "Manage and author skills.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "delete",
          "publish",
          "list_drafts"
        ],
        "description": "Authoring step to perform."
      },
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "Skill name, required for create/update/delete."
      },
      "description": {
        "type": "string",
        "description": "action=create: what the skill does and when it should be used."
      },
      "scope": {
        "type": "string",
        "enum": [
          "global",
          "persona"
        ],
        "description": "global is available to all personas; persona only to the current persona. Required for update/delete; create defaults to global.",
        "default": "global"
      },
      "draft_id": {
        "type": "string",
        "description": "action=publish: draft ID returned by create or update."
      }
    },
    "required": [
      "action"
    ]
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "skills"
  ]
}
